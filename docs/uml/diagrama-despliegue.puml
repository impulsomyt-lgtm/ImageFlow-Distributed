@startuml

title Diagrama de despliegue - ImageFlow Distributed

skinparam shadowing false
skinparam dpi 150

node "Cliente\nNavegador Web" as Cliente {
  artifact "Interfaz Web\nHTML / CSS / JavaScript" as UI
}

node "Servidor Node.js" as Servidor {

  node "Gateway\nPuerto 3000\n<<Proxy>>" as Gateway {
    artifact "gateway/server.js" as GWFile
  }

  node "Coordinator\nPuerto 3001\n<<Mediator>>" as Coordinator {
    artifact "coordinator/server.js" as CoordFile
  }

  node "Worker 1\nPuerto 4001" as Worker1 {
    artifact "worker1/server.js" as W1File
  }

  node "Worker 2\nPuerto 4002" as Worker2 {
    artifact "worker2/server.js" as W2File
  }

  node "Worker 3\nPuerto 4003" as Worker3 {
    artifact "worker3/server.js" as W3File
  }

  node "Observer\nPuerto 5000\n<<Observer>>" as Observer {
    artifact "observer/server.js" as ObsFile
  }

  database "Sistema de archivos\n/images" as Images
  artifact "Sharp\nProcesamiento de imágenes" as Sharp
}

Cliente --> Gateway : HTTP\nlocalhost:3000
Gateway --> Coordinator : HTTP\nlocalhost:3001
Coordinator --> Worker1 : HTTP\nlocalhost:4001
Coordinator --> Worker2 : HTTP\nlocalhost:4002
Coordinator --> Worker3 : HTTP\nlocalhost:4003
Coordinator --> Observer : HTTP POST\nlocalhost:5000

Worker1 --> Sharp : Usa
Worker2 --> Sharp : Usa
Worker3 --> Sharp : Usa

Sharp --> Images : Lee / escribe imágenes

@enduml